# Native PHP values use the local MySQL host. Docker Compose overrides
# DB_HOST/DB_PORT inside the app container to db/3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ioms_db
DB_USER=myshop_runtime
DB_PASSWORD=replace_with_a_long_random_runtime_password
APP_ENV=development

# Leave empty unless the deployment reverse proxy has fixed, trusted source IPs.
# Forwarded HTTPS headers are ignored from all other clients.
TRUSTED_PROXY_IPS=

# HSTS is intentionally disabled for local HTTP development. Enable it only
# when every production request is HTTPS and the hostname policy is understood.
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# Deployment/schema account only. These values are not passed to the normal
# web service and must never be committed with real credentials.
DB_SCHEMA_USER=replace_with_deployment_schema_user
DB_SCHEMA_PASSWORD=replace_with_deployment_schema_password

# Local Docker host ports. These are not database credentials.
APP_PORT=8080
MYSQL_PORT=3307

# Required only by the Docker Compose bootstrap profile. Do not commit real
# values and do not pass these variables to the normal web service.
MYSQL_ROOT_PASSWORD=replace_with_a_separate_long_random_root_password
BOOTSTRAP_ADMIN_USERNAME=replace_with_a_local_admin_username
BOOTSTRAP_ADMIN_FULL_NAME=replace_with_a_local_admin_name
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_unique_local_admin_password

# Production Compose values. The application value is an intentional sentinel:
# replace it with the reviewed immutable registry reference before deployment.
# The MySQL digest is pinned to the reviewed 8.4.3 image and must be refreshed
# deliberately during patching.
PHP_BASE_IMAGE=php:8.3-apache-bookworm@sha256:69e641a40929c9db9d1ce43b982d46f6701ccdd5f7b4c32d5bd773cae6882393
PRODUCTION_APP_IMAGE=replace_before_production
PRODUCTION_MYSQL_IMAGE=mysql:8.4.3@sha256:106d5197fd8e4892980469ad42eb20f7a336bd81509aae4ee175d852f5cc4565
