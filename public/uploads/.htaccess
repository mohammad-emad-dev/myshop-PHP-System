# Uploaded images are data only; never execute scripts from this directory.
Options -Indexes -ExecCGI

<IfModule mod_authz_core.c>
    <FilesMatch "\.(?:php|php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh
</IfModule>
